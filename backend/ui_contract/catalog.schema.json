{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amitie.mx/a2ui/v0_9/catalogs/standard/catalog.json",
  "title": "La Mesa Standard Catalog",
  "description": "A2UI v0.9 catalog for the La Mesa M3 subset. Components are implemented by the frontend. Human contract: A2UI_CATALOG.md.",
  "catalogId": "amitie.standard.v1",
  "functions": {},
  "$defs": {
    "CatalogComponentCommon": {
      "type": "object",
      "properties": {
        "weight": {
          "type": "number",
          "description": "Relative weight within a Row or Column. May only be set on a direct child of a Row or Column."
        }
      }
    },
    "anyFunction": {
      "oneOf": []
    },
    "anyComponent": {
      "oneOf": [
        { "$ref": "#/components/Column" },
        { "$ref": "#/components/Row" },
        { "$ref": "#/components/Card" },
        { "$ref": "#/components/Text" },
        { "$ref": "#/components/Heading" },
        { "$ref": "#/components/Divider" },
        { "$ref": "#/components/Badge" },
        { "$ref": "#/components/Button" },
        { "$ref": "#/components/ChoiceGroup" },
        { "$ref": "#/components/Slider" },
        { "$ref": "#/components/DebtNode" },
        { "$ref": "#/components/TradeoffScale" },
        { "$ref": "#/components/BreakAlert" },
        { "$ref": "#/components/PlanTable" },
        { "$ref": "#/components/OfferCard" },
        { "$ref": "#/components/NegotiationTranscript" },
        { "$ref": "#/components/List" },
        { "$ref": "#/components/ProgressBar" },
        { "$ref": "#/components/TextField" },
        { "$ref": "#/components/CashFlowTimeline" },
        { "$ref": "#/components/GoalJar" },
        { "$ref": "#/components/AssumptionChip" },
        { "$ref": "#/components/LineChart" },
        { "$ref": "#/components/BarChart" },
        { "$ref": "#/components/ForecastChart" },
        { "$ref": "#/components/ScenarioComparison" },
        { "$ref": "#/components/LoanOffer" }
      ]
    }
  },
  "components": {
    "Column": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "Column" },
            "children": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList" },
            "gap": { "type": "number" },
            "align": { "type": "string", "enum": ["start", "center", "end"] },
            "justify": { "type": "string", "enum": ["start", "center", "between"] }
          },
          "required": ["component", "children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Row": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "Row" },
            "children": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList" },
            "gap": { "type": "number" },
            "align": { "type": "string", "enum": ["start", "center", "end"] },
            "justify": { "type": "string", "enum": ["start", "center", "between"] }
          },
          "required": ["component", "children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Card": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "Card" },
            "children": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList" },
            "title": { "type": "string" },
            "tone": { "type": "string", "enum": ["neutral", "positive", "warning", "danger"] }
          },
          "required": ["component"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Text": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "Text" },
            "text": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString" },
            "variant": { "type": "string", "enum": ["body", "muted", "caption"] },
            "tone": { "type": "string" }
          },
          "required": ["component", "text"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Heading": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "Heading" },
            "text": { "type": "string" },
            "level": { "type": "integer", "enum": [1, 2, 3] }
          },
          "required": ["component", "text"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Divider": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "Divider" }
          },
          "required": ["component"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Badge": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "Badge" },
            "label": { "type": "string" },
            "tone": { "type": "string", "enum": ["neutral", "positive", "warning", "danger"] }
          },
          "required": ["component", "label"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Button": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "Button" },
            "label": { "type": "string" },
            "variant": { "type": "string", "enum": ["primary", "secondary", "ghost", "danger"] },
            "action": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action" }
          },
          "required": ["component", "label", "action"]
        }
      ],
      "unevaluatedProperties": false
    },
    "ChoiceGroup": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "ChoiceGroup" },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "value": { "type": "string" },
                  "label": { "type": "string" },
                  "description": { "type": "string" }
                },
                "required": ["value", "label"],
                "additionalProperties": false
              }
            },
            "value": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString" },
            "multiple": { "type": "boolean" },
            "action": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action" }
          },
          "required": ["component", "options", "action"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Slider": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "Slider" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number" },
            "value": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "label": { "type": "string" },
            "action": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action" }
          },
          "required": ["component", "min", "max", "action"]
        }
      ],
      "unevaluatedProperties": false
    },
    "DebtNode": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "DebtNode" },
            "creditor": { "type": "string" },
            "balance": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "apr": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "minPayment": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "kind": { "type": "string" },
            "badge": { "type": "string" }
          },
          "required": ["component", "creditor", "balance", "apr", "minPayment"]
        }
      ],
      "unevaluatedProperties": false
    },
    "TradeoffScale": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "TradeoffScale" },
            "leftLabel": { "type": "string" },
            "rightLabel": { "type": "string" },
            "value": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "action": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action" }
          },
          "required": ["component", "leftLabel", "rightLabel", "action"]
        }
      ],
      "unevaluatedProperties": false
    },
    "BreakAlert": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "BreakAlert" },
            "month": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "shortfall": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "reasons": { "type": "array", "items": { "type": "string" } },
            "assumptions": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["component", "month", "shortfall"]
        }
      ],
      "unevaluatedProperties": false
    },
    "PlanTable": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "PlanTable" },
            "months": {
              "oneOf": [
                { "type": "array", "items": { "type": "object" } },
                { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding" }
              ]
            },
            "breakMonth": {
              "oneOf": [
                { "type": "number" },
                { "type": "null" },
                { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding" }
              ]
            }
          },
          "required": ["component", "months"]
        }
      ],
      "unevaluatedProperties": false
    },
    "OfferCard": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "OfferCard" },
            "actor": { "type": "string", "enum": ["bank", "advocate"] },
            "headline": { "type": "string" },
            "terms": {
              "type": "object",
              "properties": {
                "apr": { "type": "number" },
                "months": { "type": "integer" },
                "monthlyPayment": { "type": "number" },
                "totalCost": { "type": "number" }
              }
            },
            "action": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action" }
          },
          "required": ["component", "actor", "headline", "terms"]
        }
      ],
      "unevaluatedProperties": false
    },
    "NegotiationTranscript": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "NegotiationTranscript" },
            "rounds": { "type": "array", "items": { "type": "object" } }
          },
          "required": ["component", "rounds"]
        }
      ],
      "unevaluatedProperties": false
    },
    "List": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "List" },
            "children": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList" },
            "ordered": { "type": "boolean" }
          },
          "required": ["component", "children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "ProgressBar": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "ProgressBar" },
            "value": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "max": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "label": { "type": "string" }
          },
          "required": ["component", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "TextField": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "TextField" },
            "label": { "type": "string" },
            "value": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString" },
            "placeholder": { "type": "string" },
            "action": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action" }
          },
          "required": ["component", "label", "action"]
        }
      ],
      "unevaluatedProperties": false
    },
    "CashFlowTimeline": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "CashFlowTimeline" },
            "points": {
              "oneOf": [
                { "type": "array", "items": { "type": "object" } },
                { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding" }
              ]
            }
          },
          "required": ["component", "points"]
        }
      ],
      "unevaluatedProperties": false
    },
    "GoalJar": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "GoalJar" },
            "label": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString" },
            "current": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "target": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "action": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action" }
          },
          "required": ["component", "label", "current", "target"]
        }
      ],
      "unevaluatedProperties": false
    },
    "AssumptionChip": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "AssumptionChip" },
            "label": { "type": "string" },
            "value": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue" },
            "editable": { "type": "boolean" },
            "path": { "type": "string" },
            "action": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action" }
          },
          "required": ["component", "label", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "LineChart": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "LineChart" },
            "points": {
              "oneOf": [
                { "type": "array", "items": { "type": "object" } },
                { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding" }
              ]
            },
            "title": { "type": "string" },
            "yLabel": { "type": "string" }
          },
          "required": ["component", "points"]
        }
      ],
      "unevaluatedProperties": false
    },
    "BarChart": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "BarChart" },
            "bars": {
              "oneOf": [
                { "type": "array", "items": { "type": "object" } },
                { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding" }
              ]
            },
            "title": { "type": "string" }
          },
          "required": ["component", "bars"]
        }
      ],
      "unevaluatedProperties": false
    },
    "ForecastChart": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "ForecastChart" },
            "forecast": {
              "oneOf": [
                { "type": "array", "items": { "type": "object" } },
                { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding" }
              ]
            },
            "actual": {
              "oneOf": [
                { "type": "array", "items": { "type": "object" } },
                { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding" }
              ]
            },
            "title": { "type": "string" }
          },
          "required": ["component", "forecast"]
        }
      ],
      "unevaluatedProperties": false
    },
    "ScenarioComparison": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "ScenarioComparison" },
            "scenarios": {
              "oneOf": [
                { "type": "array", "items": { "type": "object" } },
                { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding" }
              ]
            },
            "highlightIndex": { "type": "number" },
            "title": { "type": "string" }
          },
          "required": ["component", "scenarios"]
        }
      ],
      "unevaluatedProperties": false
    },
    "LoanOffer": {
      "type": "object",
      "allOf": [
        { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon" },
        { "$ref": "#/$defs/CatalogComponentCommon" },
        {
          "type": "object",
          "properties": {
            "component": { "const": "LoanOffer" },
            "amount": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "apr": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "months": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "monthlyPayment": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "totalInterest": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "totalCost": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "cat": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber" },
            "schedule": {
              "oneOf": [
                { "type": "array", "items": { "type": "object" } },
                { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding" }
              ]
            },
            "action": { "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action" }
          },
          "required": ["component", "amount", "apr", "months", "monthlyPayment", "totalInterest", "cat"]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
